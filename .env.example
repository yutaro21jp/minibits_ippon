# Database: postgresql or sqlite
DATABASE_ENGINE=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/minibits_ippon"
DATABASE_FILE_PATH="~/.ippon/database.sqlite"

LOG_LEVEL=debug

# Interaction mode: "api" or "cli". 
# In "api" mode, the server will expose a REST API for wallet interactions. 
# In "cli" mode, the server will provide a command-line interface for wallet interactions.
INTERACTION_MODE=api

# Required by CLI pay-execute/receive-execute. Configure only the Ed25519
# public key (base64url SPKI or PEM); keep the private signer out of this runtime.
IPPON_APPROVAL_PUBLIC_KEY=

# Server(api only)
PORT=3001


# Mints — comma-separated list of supported Cashu mint URLs.
# The first entry is the default mint used when a wallet is created without specifying a mint.
MINT_URLS=https://mint.minibits.cash/Bitcoin

# Only single wallet unit is supported: choose "sat" or "msat"
UNIT=sat

# Global limits (in wallet unit)
MAX_BALANCE=100000
MAX_SEND=50000
MAX_PAY=50000

# Rate limiting (api only)
RATE_LIMIT_MAX=100
RATE_LIMIT_CREATE_WALLET_MAX=3
RATE_LIMIT_WINDOW='1 minute'

# One-step REST value mutations and raw quote-status routes are permanently
# disabled in this fork; no environment switch enables them.

# False by default. If behind a reverse proxy, list only its IP/CIDR entries.
# Never use true or * because client-IP rate limits depend on this boundary.
TRUST_PROXY=false

# Info endpoint (api only)
SERVICE_STATUS=operational
SERVICE_HELP=https://github.com/yutaro21jp/minibits_ippon
SERVICE_TERMS=https://github.com/yutaro21jp/minibits_ippon
